# Copy to .env and choose a strong database password before starting.
TTRSS_DB_NAME=ttrss
TTRSS_DB_USER=ttrss
TTRSS_DB_PASS=

HTTP_PORT=8280
# Must match the externally visible URL, including /tt-rss/ and trailing slash.
TTRSS_SELF_URL_PATH=http://localhost:8280/tt-rss/

# Optional: if empty, upstream generates an initial admin password in app logs.
# If set, upstream reapplies this password on every app startup.
ADMIN_USER_PASS=
